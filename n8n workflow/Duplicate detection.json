    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const incomingName = String($json.name || \"\").trim().toLowerCase();\nconst incomingEmail = String($json.email || \"\").trim().toLowerCase();\nconst incomingPhone = String($json.phone || \"\").replace(/\\D/g, \"\");\n\nconst matches = Array.isArray($json.value) ? $json.value : [];\n\nif (matches.length === 0) {\n  return {\n    json: {\n      name: $json.name,\n      email: $json.email,\n      phone: $json.phone,\n\n      matched_person_id: null,\n      matched_name: null,\n      matched_email: null,\n      matched_phone: null,\n\n      name_match: false,\n      email_match: false,\n      phone_match: false,\n      match_count: 0,\n\n      status: \"NEW\",\n      match_type: \"NO MATCH\"\n    }\n  };\n}\n\nconst matched = matches[0];\n\nconst matchedName = String(matched.name || \"\").trim().toLowerCase();\nconst matchedEmail = String(matched.email || \"\").trim().toLowerCase();\nconst matchedPhone = String(matched.phone || \"\").replace(/\\D/g, \"\");\n\nconst nameMatch = incomingName === matchedName;\nconst emailMatch = incomingEmail === matchedEmail;\nconst phoneMatch = incomingPhone === matchedPhone;\n\nconst matchCount =\n  Number(nameMatch) +\n  Number(emailMatch) +\n  Number(phoneMatch);\n\nlet status;\n\nif ((nameMatch && emailMatch) || (nameMatch && phoneMatch)) {\n  status = \"DUPLICATE\";\n} else if (matchCount >= 1) {\n  status = \"WARNING\";\n} else {\n  status = \"NEW\";\n}\n\nlet matchType;\n\nif (matchCount === 0) {\n  matchType = \"NO MATCH\";\n} else if (nameMatch && emailMatch && phoneMatch) {\n  matchType = \"NAME + EMAIL + PHONE\";\n} else if (nameMatch && emailMatch) {\n  matchType = \"NAME + EMAIL\";\n} else if (nameMatch && phoneMatch) {\n  matchType = \"NAME + PHONE\";\n} else if (emailMatch && phoneMatch) {\n  matchType = \"EMAIL + PHONE\";\n} else if (nameMatch) {\n  matchType = \"NAME ONLY\";\n} else if (emailMatch) {\n  matchType = \"EMAIL ONLY\";\n} else {\n  matchType = \"PHONE ONLY\";\n}\n\nreturn {\n  json: {\n    name: $json.name,\n    email: $json.email,\n    phone: $json.phone,\n\n    matched_person_id: matched.person_id,\n    matched_name: matched.name,\n    matched_email: matched.email,\n    matched_phone: matched.phone,\n\n    name_match: nameMatch,\n    email_match: emailMatch,\n    phone_match: phoneMatch,\n    match_count: matchCount,\n\n    status,\n    match_type: matchType\n  }\n};"
      },
